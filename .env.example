# Conexão PostgreSQL para o Prisma ORM (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/musica_do_dia?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/musica_do_dia"

# Senha para acesso ao painel administrativo (/admin)
ADMIN_PASSWORD="troque_por_uma_senha_forte"

# Segredo para autenticar o Vercel Cron (/api/cron/check-schedule)
CRON_SECRET="troque_por_um_segredo_cron_forte"

# Configurações do Bot do Telegram para alerta de poucos desafios agendados (< 5 dias)
TELEGRAM_BOT_TOKEN="123456789:ABCDEF_seu_token_do_botfather"
TELEGRAM_CHAT_ID="seu_chat_id_aqui"




